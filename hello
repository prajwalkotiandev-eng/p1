Practical no 2. Perform Text Preprocessing and Generate Word Cloud using tm Package in R
Step1: 
install.packages("tm")
install.packages("wordcloud")
install.packages("RColorBrewer")
 
Step2: 
library(tm)
library(wordcloud)
library(RColorBrewer) 

Step3: 
library(RColorBrewer)
text_data <- c(
  "Data science is an interdisciplinary field",
  "Machine learning is part of data science",
  "Text mining and data mining are important",
  "R programming is widely used for data analysis"
)
corpus <- Corpus(VectorSource(text_data)) 

Step4: 
corpus <- tm_map(corpus, content_transformer(tolower))
corpus <- tm_map(corpus, removePunctuation)
corpus <- tm_map(corpus, removeNumbers)
corpus <- tm_map(corpus, removeWords, stopwords("english"))
corpus <- tm_map(corpus, stripWhitespace)

Step5: 
dtm <- DocumentTermMatrix(corpus)
dtm_matrix <- as.matrix(dtm)
word_freq <- colSums(dtm_matrix)
word_freq <- sort(word_freq, decreasing = TRUE)
word_freq

Step6: 
wordcloud(
  names(word_freq),
  word_freq,
  min.freq = 1,
  max.words = 100,
  random.order = FALSE,
  colors = brewer.pal(8, "Dark2")
)

