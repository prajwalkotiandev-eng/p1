Practical 9: Anomaly Detection 
Steps: 
Step 1: # Install and package 
install.packages("isotree")
library(isotree)

Step 2: Create Sample Dataset 
data <- data.frame(
  transactions = c(100, 120, 130, 150, 170, 200, 500, 210, 220, 230)
)
data

Step 3: Train Isolation Forest Model 
model <- isolation.forest(data, sample_size = 10, ntrees = 100)

Step 4: Predict Anomaly Scores 
scores <- predict(model, data)
scores
 
Step 5: Identify Anomalies
data$anomaly_score <- scores
data$anomaly <- ifelse(data$anomaly_score > 0.6, "Anomaly", "Normal")
print(data) 
 

