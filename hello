Practical No. 4: Linear regression 
Steps: 
Step 1: # Create dataset 
hours <- c(1, 2, 3, 4, 5)
scores <- c(50, 55, 65, 70, 75)
data <- data.frame(hours, scores)
print(data)

Step 2: # Apply linear regression 
model <- lm(scores ~ hours, data = data)
summary(model)
 
Step 3: # Predict New Score 
new_data <- data.frame(hours = 6)
predict(model, new_data)

Step 4: # Plot data points 
plot(data$hours, data$scores,
     main = "Linear Regression Example",
     xlab = "Study Hours",
     ylab = "Scores",
     pch = 16)

Step 5: # Add regression line 
abline(model, col = "blue")

