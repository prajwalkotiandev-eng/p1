P66 :--Show the implementation of clustering algorithm:

#1.Load the dataset
data(iris)

#2.Select only the numeric columns for 2D clustering
df <- iris[, 1:2]

#3.Standardize the data (Scaling) for better performance
df_scaled <- scale(df)

#4.Calculate Total Within-Cluster Sum of Squares (WSS)
wss <- (nrow(df_scaled)-1)*sum(apply(df_scaled,2,var))
for (i in 2:10) wss[i] <- sum(kmeans(df_scaled, centers=i)$withinss)

#5.Plot the Elbow Method
plot(1:10, wss, type="b", pch=19, col="darkred",
     xlab="Number of Clusters (K)",
     ylab="Total Within-clusters Sum of Squares",
     main="The Elbow Method to find Optimal K")

#6.Set seed for reproducibility
set.seed(123)

#7.Run K-Means with 3 clusters
km_result <- kmeans(df_scaled, centers = 3, nstart = 25)

#8.View the cluster assignments and sizes
print(km_result$size)
print(km_result$centers)


P77 :-Show the implementation of time series analysis.

#1.Load and Inspect the Data 
data("AirPassengers")
class(AirPassengers) # Confirming it is a 'ts' (Time Series) object

#View the start, end, and frequency (12 = Monthly)
start(AirPassengers)
end(AirPassengers)
frequency(AirPassengers)

#2.Basic Visualization
#Plotting the raw data to see the trend and seasonality
plot(AirPassengers, 
     main = "Monthly Airline Passenger Numbers (1949-1960)",
     ylab = "Total Passengers (in thousands)", 
     xlab = "Year",
     col = "blue", lwd = 2)

#3.Time Series Decomposition (The "Proper" Step) 
#Decomposing breaks the data into: Trend, Seasonal, and Random components
# We use 'multiplicative' because the seasonal variation increases with time
decomposed_data <- decompose(AirPassengers, type = "multiplicative")
#Plot the decomposed components
plot(decomposed_data, col = "darkgreen")

#4.Seasonal Analysis (Boxplot)
# This shows exactly which months have the highest travel (Seasonality)
boxplot(AirPassengers ~ cycle(AirPassengers), 
        main = "Seasonal Variation in Air Passengers",
        xlab = "Month (1 = Jan, 12 = Dec)", 
        ylab = "Passengers",
        col = "orange")

#5.Check for Stationarity (Bonus Marks)
# Log transformation is often used to stabilize the variance
plot(log(AirPassengers), main = "Log-Transformed Time Series", col = "red")
