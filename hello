P22 :-Perform text preprocessing and generate word cloud using tm package in r:

# install.packages(c("tm", "wordcloud", "RColorBrewer"))
library(tm)
library(wordcloud)
library(RColorBrewer)

# Sample textual data (e.g., related to your MedRed project or Data Science)
text_data <- c(
  "Data Science is an interdisciplinary field that uses scientific methods.",
  "Machine Learning is a subset of artificial intelligence and deep         learning.",
  "R programming is widely used for statistical analysis and text mining.",
  "Data cleaning and text preprocessing are essential steps in AI.",
  "Word clouds provide a visual representation of text data frequencies.",
  "Flutter and Node.js are used for mobile and backend development."
)

# Create a Corpus
docs <- Corpus(VectorSource(text_data))

#1. Convert to Lowercase (Standardization)
docs <- tm_map(docs, content_transformer(tolower))

#2. Remove Numbers
docs <- tm_map(docs, removeNumbers)

#3. Remove Punctuation
docs <- tm_map(docs, removePunctuation)

#4. Remove Stop Words (Common words like 'the', 'is', 'at')
docs <- tm_map(docs, removeWords, stopwords("english"))

#5. Eliminate Extra White Spaces
docs <- tm_map(docs, stripWhitespace)

#6. To build the cloud, we must count word occurrences using a Term-Document Matrix.
dtm <- TermDocumentMatrix(docs)
matrix <- as.matrix(dtm)
words <- sort(rowSums(matrix), decreasing = TRUE)
df <- data.frame(word = names(words), freq = words)

# 7. Generate Word Cloud
set.seed(1234) # For a consistent layout
wordcloud(words = df$word, freq = df$freq, min.freq = 1,
          max.words = 100, random.order = FALSE, rot.per = 0.35, 
          colors = brewer.pal(8, "Dark2"))


